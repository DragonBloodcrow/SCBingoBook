# =============================================================================
# SCBingoBook — production deployment (.env on Ubuntu server)
# Copy: cp .env.example .env   then edit ALL values marked REQUIRED
# =============================================================================

# --- PostgreSQL (internal to Docker; not exposed to the internet) ---
POSTGRES_USER=scbingobook
POSTGRES_PASSWORD=REQUIRED_change_this_strong_password
POSTGRES_DB=scbingobook

# --- Public URL (how users reach the app in a browser) ---
# Examples: http://203.0.113.10   https://bingo.example.com
PUBLIC_URL=http://YOUR_SERVER_IP_OR_DOMAIN

# CORS must match PUBLIC_URL (same origin when using bundled nginx proxy)
CORS_ORIGIN=http://YOUR_SERVER_IP_OR_DOMAIN

# --- JWT (REQUIRED — use a long random string, e.g. openssl rand -base64 48) ---
JWT_SECRET=REQUIRED_change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Web entrypoint (only port exposed on the host) ---
HTTP_PORT=80

# Seed sample catalog items on first deploy only, then set to false
RUN_SEED=true
